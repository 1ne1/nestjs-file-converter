# Server options
PORT=3007
NODE_ENV=development
COOKIE_SECRET=my-secret

# Health check
HEALTH_CHECK_ENABLED=false

# Throttler
THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=10
SENSITIVE_THROTTLE_LIMIT=5
SENSITIVE_THROTTLE_TTL_MS=60000

# CORS allowlist (comma-separated, no wildcard)
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:4200,http://localhost:8080

# Database (PostgreSQL, used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5433

# Prisma connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/app

# Object storage (S3-compatible, MinIO locally via docker-compose)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=app
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin123
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001

# JWT signing secrets (access/refresh use separate secrets)
JWT_ACCESS_SECRET=my-access-secret
JWT_REFRESH_SECRET=my-refresh-secret

# Email (SMTP - turboSMTP in production, Mailhog locally via docker-compose)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_WEB_PORT=8025

# Public base URL, used to build magic-link confirmation URLs
APP_BASE_URL=http://localhost:3007

# Email confirmation toggles (per-flow, admin-configurable later)
REGISTRATION_EMAIL_CONFIRMATION_ENABLED=false
REGISTRATION_CONFIRMATION_METHOD=OTP
LOGIN_EMAIL_CONFIRMATION_ENABLED=false
LOGIN_CONFIRMATION_METHOD=OTP

# File conversion (POST /api/convert): global multipart safety net, then
# per-source-format limits enforced in application logic
UPLOAD_MAX_BYTES=10485760
CONVERT_TIMEOUT_SECONDS=30
CONVERT_MAX_SIZE_CSV_BYTES=5242880
CONVERT_MAX_SIZE_JSON_BYTES=5242880
CONVERT_MAX_SIZE_XML_BYTES=5242880
CONVERT_MAX_SIZE_YAML_BYTES=5242880

# Image conversion (POST /api/images/convert)
IMAGE_MAX_SIZE_PNG_BYTES=5242880
IMAGE_MAX_SIZE_JPEG_BYTES=5242880
IMAGE_MAX_SIZE_SVG_BYTES=2097152
IMAGE_MAX_RASTER_WIDTH=4096
IMAGE_MAX_RASTER_HEIGHT=4096
IMAGE_DEFAULT_RASTER_WIDTH=800
IMAGE_DEFAULT_RASTER_HEIGHT=600

# Transformation history / saved-file retention (both, section 11-12)
HISTORY_RETENTION_DAYS=90
